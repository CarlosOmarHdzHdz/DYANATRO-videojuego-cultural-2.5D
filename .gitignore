# Unity generated folders
[Aa]ssets/_Recovery/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
!/Assets/Editor/Build/
[Bb]uilds/
[Ll]ogs/
[Ll]ogs.meta
[Uu]ser[Ss]ettings/
.vs/

# IDE and generated project files
*.csproj
*.sln
*.slnx
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# OS files
.DS_Store
Thumbs.db

# Local QA/export scratch data
qa_corregido/
qa2/
Respaldo/
Respaldo_2D_Completo_NoImportar/
Respaldo_PackageManager_NoImportar/
tmp/
tmp_pdf/
Temp/
output/visual-review/*.png
output/visual-review/*.mp4
output/visual-review/*.txt

# Keep project documentation and source assets tracked.
# La documentacion academica se conserva fuera del proyecto; no se publica.
*.doc
*.docx
*.docm
*.dotx
*.pdf
~$*
!/Docs/Build/

# Local historical backups and generated diagnostics, never imported by Unity.
/Archive/
/output/logs/
/output/qa/
/output/*.log
/output/project-organization/**/source-before/
/output/project-organization/**/hashes-before.tsv

# Pruebas locales de herbolaria (proyecto aislado, capturas y registros).
/output/herbalism-validation/
/output/herbalism-*.log

# Todos los resultados generados son locales; los informes ya versionados se conservan.
/output/
